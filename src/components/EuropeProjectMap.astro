---
import world from 'world-atlas/countries-50m.json';
import { feature } from 'topojson-client';

const { peaks, ariaLabel = 'Crown of Europe map' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const VIEW = { minLon: -25, maxLon: 45, minLat: 34, maxLat: 72, width: 1100, height: 650 };

const project = ([lon, lat]) => {
  const x = ((lon - VIEW.minLon) / (VIEW.maxLon - VIEW.minLon)) * VIEW.width;
  const y = ((VIEW.maxLat - lat) / (VIEW.maxLat - VIEW.minLat)) * VIEW.height;
  return [x, y];
};

const ringBounds = (ring) => ring.reduce((b, [lon, lat]) => ({
  minLon: Math.min(b.minLon, lon), maxLon: Math.max(b.maxLon, lon),
  minLat: Math.min(b.minLat, lat), maxLat: Math.max(b.maxLat, lat),
}), { minLon: Infinity, maxLon: -Infinity, minLat: Infinity, maxLat: -Infinity });

const intersectsView = (ring) => {
  const b = ringBounds(ring);
  return b.maxLon >= VIEW.minLon && b.minLon <= VIEW.maxLon &&
         b.maxLat >= VIEW.minLat && b.minLat <= VIEW.maxLat;
};

const ringToPath = (ring) => {
  if (!ring?.length || !intersectsView(ring)) return '';
  return ring.map(([lon, lat], i) => {
    const [x, y] = project([lon, lat]);
    return `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`;
  }).join(' ') + ' Z';
};

const geometryToPaths = (geometry) => {
  if (!geometry) return [];
  if (geometry.type === 'Polygon') {
    return geometry.coordinates.slice(0, 1).map(ringToPath).filter(Boolean);
  }
  if (geometry.type === 'MultiPolygon') {
    return geometry.coordinates.flatMap(poly => poly.slice(0, 1).map(ringToPath)).filter(Boolean);
  }
  return [];
};

const worldGeo = feature(world, world.objects.countries);

const normalize = (name) => {
  const aliases = {
    'Czech Republic': 'Czechia',
    'Macedonia': 'North Macedonia',
    'Vatican': 'Vatican City',
  };
  return aliases[name] ?? name;
};

const countryMeta = new Map();
for (const peak of peaks) {
  const countries = peak.countries ?? [peak.country];
  const slugs = peak.countrySlugs ?? [peak.countrySlug];
  countries.forEach((country, i) => {
    const existing = countryMeta.get(country);
    const status = peak.status === 'climbed'
      ? 'climbed'
      : peak.status === 'planned'
        ? 'planned'
        : (existing?.status ?? 'not-climbed');
    countryMeta.set(country, {
      status,
      slug: slugs[i] ?? peak.countrySlug,
      peakSlug: peak.slug,
    });
  });
}

const countries = worldGeo.features
  .map(f => ({
    name: normalize(f.properties?.name ?? ''),
    geometry: f.geometry,
  }))
  .map(c => ({ ...c, paths: geometryToPaths(c.geometry) }))
  .filter(c => c.paths.length);

const microstates = [
  ['Andorra', 42.5063, 1.5218],
  ['Liechtenstein', 47.166, 9.5554],
  ['Luxembourg', 49.8153, 6.1296],
  ['Monaco', 43.7384, 7.4246],
  ['San Marino', 43.9424, 12.4578],
  ['Vatican City', 41.9029, 12.4534],
  ['Malta', 35.9375, 14.3754],
].map(([name, lat, lon]) => {
  const [x, y] = project([lon, lat]);
  return { name, x, y, meta: countryMeta.get(name) };
}).filter(d => d.meta);
---
<div class="project-map-shell">
  <svg class="project-map" viewBox={`0 0 ${VIEW.width} ${VIEW.height}`} role="img" aria-label={ariaLabel}>
    <rect class="map-sea" x="0" y="0" width={VIEW.width} height={VIEW.height} rx="8" />

    <g class="map-countries">
      {countries.map(country => {
        const meta = countryMeta.get(country.name);
        const status = meta?.status ?? 'neutral';
        const content = country.paths.map(path => (
          <path
            class:list={['map-country', status]}
            d={path}
            aria-label={country.name}
          />
        ));
        return meta
          ? <a href={`${base}countries/${meta.slug}/`} aria-label={`Explore ${country.name}`}>{content}</a>
          : content;
      })}
    </g>

    <g class="map-microstates">
      {microstates.map(({ name, x, y, meta }) => (
        <a href={`${base}countries/${meta.slug}/`} aria-label={`Explore ${name}`}>
          <circle class:list={['microstate-ring', meta.status]} cx={x} cy={y} r="8" />
          <circle class:list={['microstate-dot', meta.status]} cx={x} cy={y} r="4" />
        </a>
      ))}
    </g>
  </svg>
</div>

<div class="map-legend home-legend">
  <span><i class="legend-dot climbed"></i>Climbed</span>
  <span><i class="legend-dot planned"></i>Planned</span>
  <span><i class="legend-dot not-climbed"></i>To climb</span>
</div>
