---
import Layout from '../../layouts/Layout.astro'; import peaks from '../../data/crown-of-europe.json';
const climbed=peaks.filter(p=>p.status==='climbed'); const highest=climbed.length?Math.max(...climbed.map(p=>p.height??0)):null;
---
<Layout title="Crown of Europe — Szwendacz"><main class="wrap"><section class="hero"><div class="eyebrow">Project</div><h1>Crown of<br/>Europe.</h1><p class="lead">A journey to the highest points of European countries. Each summit will connect to its country, trip report, route statistics and photographs.</p></section><div class="stats"><div class="stat"><strong>{climbed.length}/{peaks.length}</strong><span>peaks climbed</span></div><div class="stat"><strong>{highest?`${highest} m`:'—'}</strong><span>highest climbed</span></div><div class="stat"><strong>—</strong><span>total elevation gain</span></div></div><section><div class="eyebrow">Peak list</div><h2>All peaks</h2><table><thead><tr><th>Country</th><th>Peak</th><th>Height</th><th>Status</th></tr></thead><tbody>{peaks.map(p=><tr><td>{p.country}</td><td>{p.name}</td><td>{p.height?`${p.height} m`:'—'}</td><td>{p.status==='climbed'?'Climbed':'Not climbed'}</td></tr>)}</tbody></table></section></main></Layout>