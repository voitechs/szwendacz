---
import Layout from '../../layouts/Layout.astro';
import peaks from '../../data/crown-of-europe.json';

const validPeaks = peaks.filter(p => p.slug && p.countrySlug);
const climbed = validPeaks.filter(p => p.status === 'climbed');
const highest = climbed.length ? Math.max(...climbed.map(p => p.height ?? 0)) : null;
const elevationGain = climbed.reduce((sum,p)=>sum+(p.elevationGain ?? 0),0);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const project = ([lat, lon]) => {
  const minLon = -25, maxLon = 45, minLat = 34, maxLat = 72;
  return [
    ((lon - minLon) / (maxLon - minLon)) * 1000,
    ((maxLat - lat) / (maxLat - minLat)) * 620
  ];
};
const mapPeaks = validPeaks.filter(p => p.countryCenter).map(p => {
  const [x,y] = project(p.countryCenter);
  return {...p, x, y};
});
---
<Layout title="Crown of Europe — Szwendacz">
<main class="wrap">
<section class="hero compact">
  <div class="eyebrow">Project</div>
  <h1>Crown of<br/>Europe.</h1>
  <p class="lead">Climbing the highest point of every European country — one summit, one country and one story at a time.</p>
</section>

<div class="stats">
  <div class="stat"><strong>{climbed.length}/{validPeaks.length}</strong><span>peaks climbed</span></div>
  <div class="stat"><strong>{highest ? `${highest} m` : '—'}</strong><span>highest climbed</span></div>
  <div class="stat"><strong>{elevationGain ? `${elevationGain.toLocaleString()} m` : '—'}</strong><span>total elevation gain</span></div>
</div>

<section>
  <div class="section-head">
    <div><div class="eyebrow">Explore the project</div><h2>Europe map</h2></div>
  </div>
  <div class="svg-map-shell">
    <svg class="europe-map" viewBox="0 0 1000 620" role="img" aria-label="Crown of Europe map">
      <rect x="0" y="0" width="1000" height="620" fill="#eceae2" />
      <path class="continent-shape" d="M115 120 L170 75 L240 95 L278 145 L340 130 L386 165 L450 150 L505 175 L555 160 L615 190 L650 240 L690 270 L720 325 L690 370 L635 385 L600 430 L535 445 L500 490 L430 500 L370 470 L320 490 L270 455 L220 420 L185 370 L150 330 L135 275 L105 230 Z"/>
      {mapPeaks.map(p => (
        <a href={`${base}projects/crown-of-europe/${p.slug}/`}>
          <circle class:list={['map-point-ring', p.status]} cx={p.x} cy={p.y} r={p.status === 'climbed' ? 13 : 9} />
          <circle class:list={['map-point', p.status]} cx={p.x} cy={p.y} r={p.status === 'climbed' ? 7 : 5} />
        </a>
      ))}
    </svg>
  </div>
</section>

<section>
  <div class="section-head">
    <div><div class="eyebrow">{validPeaks.length} summits</div><h2>Peak list</h2></div>
  </div>
  <div class="peak-list">
    {validPeaks.map(p => (
      <a class="peak-row" href={`${base}projects/crown-of-europe/${p.slug}/`}>
        <span class:list={['status-dot', p.status]}></span>
        <span class="country-name">{p.country}</span>
        <strong>{p.name}</strong>
        <span class="height">{p.height ? `${p.height} m` : '—'}</span>
        <span class="arrow">→</span>
      </a>
    ))}
  </div>
</section>
</main>
</Layout>
