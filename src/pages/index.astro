---
import Layout from '../layouts/Layout.astro'; import peaks from '../data/crown-of-europe.json';
const countries=new Set(peaks.map(p=>p.country)).size; const climbed=peaks.filter(p=>p.status==='climbed').length; const base=import.meta.env.BASE_URL;
---
<Layout title="Szwendacz — Stories from the road"><main class="wrap"><section class="hero"><div class="eyebrow">Travel journal · Mountains · Projects</div><h1>Stories from<br/>the road.</h1><p class="lead">A personal record of journeys, places and mountains — explored country by country, trail by trail.</p></section><div class="stats"><div class="stat"><strong>{countries}</strong><span>countries in Crown of Europe</span></div><div class="stat"><strong>{peaks.length}</strong><span>project peaks</span></div><div class="stat"><strong>{climbed}</strong><span>peaks climbed</span></div></div><section id="map"><div class="eyebrow">Interactive geography</div><h2>Map</h2><p class="lead">The interactive map will connect countries, places, peaks and trip reports in the next iteration.</p></section><section><div class="card"><div class="eyebrow">Featured project</div><h2>Crown of Europe</h2><p>Climbing the highest point of every European country.</p><p><strong>{climbed} / {peaks.length}</strong> peaks climbed</p><a class="button" href={`${base}projects/crown-of-europe`}>Explore the project →</a></div></section><section id="travels"><div class="eyebrow">Travel journal</div><h2>Latest journeys</h2><p class="muted">Trip reports and photo stories will appear here as you add them.</p></section></main></Layout>